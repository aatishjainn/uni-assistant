			"name": "08. Mandatory Security Tests (PDF Section 6 & 8)",
			"item": [
				{
					"name": "Test Scenario 10: Student Attempting to Access Another Student's Records (MUST BE BLOCKED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Cross-student privacy guard triggers or blocks inquiry', function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data.reply.toLowerCase()).to.satisfy(function(str) {",
									"        return str.includes('privacy') || str.includes('only') || str.includes('cannot') || str.includes('authorized') || str.includes('deny');",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
