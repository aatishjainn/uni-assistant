							]
						}
					}
				},
				{
					"name": "Compute Walking Route (Dijkstra MinHeap)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/campus/route?from=QR-GATE&to=Room%20201%20(BCA)&accessible=false",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"campus",
								"route"
							],
							"query": [
								{
									"key": "from",
									"value": "QR-GATE"
								},
