# Database (PostgreSQL + pgvector)
DB_USER=uni_admin
DB_PASSWORD=your_secure_password
DB_NAME=uni_assistant
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
JWT_EXPIRES_IN=8h

# Service-to-Service Secret (Express <-> FastAPI)
AI_SERVICE_TOKEN=replace_with_a_long_random_service_token

# AI Microservice Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
GEMINI_AGENT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# Express Backend
PORT=4000
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
UNIVERSITY_TZ=Asia/Kolkata
STORAGE_DIR=../storage
